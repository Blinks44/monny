{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "attribution": {
    "commit": ""
  },
  "permissions": {
    "allow": [
      "Bash(apps/monny/scripts/dev.sh doctor)",
      "Bash(apps/monny/scripts/dev.sh build *)",
      "Bash(apps/monny/scripts/dev.sh build)",
      "Bash(apps/monny/scripts/dev.sh build-for-testing)",
      "Bash(apps/monny/scripts/dev.sh test)",
      "Bash(apps/monny/scripts/dev.sh test *)",
      "Bash(apps/monny/scripts/dev.sh lint)",
      "Bash(apps/monny/scripts/dev.sh format)",
      "Bash(pnpm check)",
      "Bash(pnpm test)",
      "Bash(pnpm build)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)"
    ],
    "deny": [
      "Read(./**/.env)",
      "Read(./**/.env.local)",
      "Read(./**/.env.*.local)",
      "Read(./**/.dev.vars*)",
      "Read(./**/*.p12)",
      "Read(./**/*.pfx)",
      "Read(./**/monny_sparkle_ed25519.key)"
    ]
  }
}
