          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Charts appear as Monny collects readings. Daily and weekly history is saved between launches."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los gráficos aparecen a medida que Monny recopila datos. El historial diario y semanal se conserva entre sesiones."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les graphiques apparaissent à mesure que Monny collecte les mesures. Les historiques quotidiens et hebdomadaires sont conservés entre les lancements."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Графики появятся по мере сбора данных. История за сутки и неделю сохраняется между запусками."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
