    "Asks for your admin password once. Only controls charging." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fragt einmal nach dem Administratorpasswort. Steuert nur das Laden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pide la contraseña de administrador una vez. Solo controla la carga."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Demande une fois le mot de passe administrateur. Ne contrôle que la charge."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Один раз запросит пароль администратора. Управляет только зарядкой."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只需输入一次管理员密码。仅控制充电。"
