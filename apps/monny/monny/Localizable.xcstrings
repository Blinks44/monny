    "Charts fill in while Monny runs. The 24 h and 7 d ranges are kept across restarts." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Diagramme füllen sich, während Monny läuft. 24 Std. und 7 Tage bleiben nach einem Neustart erhalten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los gráficos se llenan mientras Monny funciona. Los rangos de 24 h y 7 d se conservan tras reiniciar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les graphiques se remplissent pendant que Monny fonctionne. Les plages 24 h et 7 j sont conservées après un redémarrage."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Графики заполняются, пока Monny работает. Данные за 24 ч и 7 дней сохраняются после перезапуска."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "图表会在 Monny 运行时逐渐填充。24 小时和 7 天的数据在重启后保留。"
          }
        }
      }
    },
