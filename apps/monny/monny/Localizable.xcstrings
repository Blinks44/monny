        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось удалить помощника. Управление зарядкой остаётся выключенным. Повтори попытку."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
