    "The helper couldn’t be removed. Charging control remains off. Try again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Helfer konnte nicht entfernt werden. Die Ladesteuerung bleibt aus. Versuche es erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The helper couldn’t be removed. Charging control remains off. Try again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se ha podido eliminar el módulo. El control de carga sigue desactivado. Vuelve a intentarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de supprimer le module. Le contrôle de charge reste désactivé. Réessayez."
