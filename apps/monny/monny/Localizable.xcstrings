    "Monny uses the charge limit built into macOS, the same setting as in Battery Settings." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Monny nutzt das in macOS integrierte Ladelimit, dieselbe Einstellung wie in den Batterieeinstellungen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Monny uses the charge limit built into macOS, the same setting as in Battery Settings."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Monny usa el límite de carga integrado en macOS, el mismo ajuste que en los ajustes de batería."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Monny utilise la limite de charge intégrée à macOS, le même réglage que dans les réglages Batterie."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Monny использует лимит заряда, встроенный в macOS. Это та же настройка, что в разделе «Аккумулятор»."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Monny 使用 macOS 内置的充电上限，与电池设置中的选项相同。"
          }
        }
      }
    },
    "Monny uses the macOS charge limit. You do not need to turn it off in System Settings first." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Monny verwendet das macOS-Ladelimit. Du musst es vorher nicht in den Systemeinstellungen deaktivieren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Monny uses the macOS charge limit. You do not need to turn it off in System Settings first."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Monny usa el límite de carga de macOS. No necesitas desactivarlo antes en Ajustes del Sistema."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Monny utilise la limite de charge macOS. Il n’est pas nécessaire de la désactiver au préalable."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Monny использует встроенный лимит macOS. Заранее отключать его в системных настройках не нужно."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Monny 使用 macOS 充电上限，无需先在系统设置中将其关闭。"
          }
        }
      }
    },
