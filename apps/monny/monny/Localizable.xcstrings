    "Optimized Battery Charging can also delay charging. Monny does not change that setting." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Optimiertes Laden kann das Laden ebenfalls verzögern. Monny ändert diese Einstellung nicht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Optimized Battery Charging can also delay charging. Monny does not change that setting."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La carga optimizada también puede retrasar la carga. Monny no cambia ese ajuste."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La recharge optimisée peut aussi différer la charge. Monny ne modifie pas ce réglage."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Оптимизированная зарядка» тоже может откладывать зарядку. Monny эту настройку не меняет."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "优化电池充电也可能延迟充电。Monny 不会更改该设置。"
