    "Charging goes back to macOS. The charge limit and charging modes will be unavailable until you install the helper again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS übernimmt das Laden. Ladelimit und Lademodi sind bis zur erneuten Installation des Helfers nicht verfügbar."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Charging goes back to macOS. The charge limit and charging modes will be unavailable until you install the helper again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS volverá a gestionar la carga. El límite y los modos de carga no estarán disponibles hasta que reinstales el módulo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS reprend la gestion de la charge. La limite et les modes de charge seront indisponibles jusqu’à la réinstallation du module."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Зарядкой будет управлять macOS. Лимит и режимы зарядки будут недоступны до повторной установки помощника."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "充电将由 macOS 管理。重新安装辅助程序前，充电上限和充电模式将不可用。"
          }
        }
      }
    },
    "Charging is left to macOS" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS verwaltet das Laden"
          }
        },
        "en" : {
          "stringUnit" : {
