    "When you stop using Monny’s charging controls, you can turn macOS charging features back on." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn du Monny nicht mehr zur Ladesteuerung nutzt, kannst du die macOS-Ladefunktionen wieder aktivieren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When you stop using Monny’s charging controls, you can turn macOS charging features back on."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuando dejes de controlar la carga con Monny, puedes volver a activar las funciones de carga de macOS."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quand vous cessez de contrôler la charge avec Monny, vous pouvez réactiver les fonctions de charge de macOS."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Когда перестанете управлять зарядкой через Monny, можно снова включить функции зарядки macOS."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "停止使用 Monny 控制充电后，可以重新启用 macOS 的充电功能。"
          }
        }
      }
    },
