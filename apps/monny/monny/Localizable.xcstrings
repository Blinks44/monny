    "Passively cooled. macOS slows the CPU when it gets hot." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passiv gekühlt. macOS senkt bei Bedarf die CPU-Leistung, um die Temperatur zu begrenzen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passively cooled. macOS reduces CPU performance when needed to manage temperature."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Refrigeración pasiva. macOS reduce el rendimiento de la CPU cuando es necesario para controlar la temperatura."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Refroidissement passif. macOS réduit les performances du processeur si nécessaire pour limiter la température."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пассивное охлаждение. При перегреве macOS снижает производительность ЦП."
