{
  "name": "@monny/website",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 3000",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 3000",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --deny-warnings .",
    "format": "oxfmt --write .",
    "test": "vitest run",
    "check": "pnpm run prepare && pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
    "deploy": "pnpm check && pnpm build && wrangler deploy",
    "deploy:dry-run": "pnpm build && wrangler deploy --dry-run",
    "format:check": "oxfmt --check .",
    "prepare": "paraglide-js compile --project ./project.inlang --outdir ./src/integrations/i18n/paraglide --strategy url baseLocale",
    "test:smoke": "node --test src/test/worker.smoke.ts"
  },
  "dependencies": {
    "@ark-ui/react": "^5.39.3",
    "@moduix/react": "^3.0.1",
    "@tanstack/react-router": "^1.170.45",
    "@tanstack/react-start": "^1.169.3",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.64.0",
    "@inlang/paraglide-js": "^2.29.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "wrangler": "^4.151.3"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@12.14.0"
}
