{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "monny-website",
  "main": "src/server.ts",
  "compatibility_date": "2026-10-19",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "monny.moduix.dev", "custom_domain": true }],
}
