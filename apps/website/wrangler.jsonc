{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "monny-website",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  // The server bundle from `rsbuild build`; static files are served from dist/client before it runs.
  "main": "dist/server/index.js",
  "assets": { "directory": "dist/client" },
  // moduix.dev is on Cloudflare, so the DNS record and certificate are created on deploy.
  "routes": [{ "pattern": "monny.moduix.dev", "custom_domain": true }]
}
